# MCP Integration Credentials
# Copy this file to .env and fill in your values

# Gmail (for reading emails and sending follow-ups)
GMAIL_CREDENTIALS_PATH=./credentials/gmail-credentials.json

# Google Sheets (for logging leads and reports)
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials/sheets-credentials.json

# Telegram (for morning summary notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Make.com (for triggering scenarios)
MAKE_API_KEY=your-make-api-key

# OpenCode data directory (shared)
XDG_DATA_HOME=./workspace/opencode-data
